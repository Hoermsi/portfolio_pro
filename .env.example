# Portfolio Pro - Vorlage für die lokale .env
# Kopieren nach .env (im Datenordner oder im Code-Ordner) und Werte eintragen.
# Diese Datei enthält KEINE echten Werte - niemals echte Keys hier eintragen/committen.

# Claude API (Senior Asset Manager, KI-Portfolios, Trading-Bot-Berichte, Chat) -
# separater Anthropic-Console-Key, NICHT das Claude-Pro-Abo.
ANTHROPIC_API_KEY=

# Kraken (read-only Sync von Beständen/Einstandskursen/EUR-Cash) - Key braucht
# die Berechtigungen "Query Funds" und "Query Closed Orders & Trades".
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Hyperliquid Trading-Bot: Agent-Wallet-Key mit Handelsvollmacht (kann Orders
# senden, aber nicht auszahlen) - wird NUR aus der Umgebung gelesen, nie in
# der DB gespeichert.
HYPERLIQUID_AGENT_KEY=
# Öffentliche Konto-Adresse des Hyperliquid-Kontos (kein Geheimnis, gehört
# aber inhaltlich zusammen mit dem Agent-Key).
HYPERLIQUID_ACCOUNT_ADDRESS=

# Trading-Bot: Telegram-Benachrichtigungen bei neuen Orders, Stop-Loss,
# Signal-Ausstiegen und Sicherheitsalarmen (Kill-Switch, Runner-Ausfall) -
# nur im Live-Modus, Dry-Run/Papierhandel bleibt stumm. Einrichtung:
# 1. Bei @BotFather (https://t.me/BotFather) einen Bot anlegen -> Token.
# 2. Dem eigenen Bot einmal eine beliebige Nachricht schreiben.
# 3. https://api.telegram.org/bot<TOKEN>/getUpdates im Browser öffnen und
#    "chat":{"id": ...} aus der Antwort als TELEGRAM_CHAT_ID übernehmen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
